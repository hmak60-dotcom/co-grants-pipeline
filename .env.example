# Supabase — use the SERVICE ROLE key here, not anon, since this runs server-side
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — used to normalize messy scraped/API text into clean structured rows
ANTHROPIC_API_KEY=your-anthropic-key

# Grants.gov — public API, no key required, but base URL kept configurable
GRANTS_GOV_API_BASE=https://api.grants.gov/v1/api

# Optional — only needed once you subscribe to one of these for foundation-grant volume
CANDID_API_KEY=
GRANTWATCH_API_KEY=

# NCES Common Core of Data — public, no key required
NCES_CCD_BASE=https://nces.ed.gov/ccd/files.asp
